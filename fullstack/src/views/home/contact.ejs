<section class="mx-auto max-w-6xl py-8">
  <div class="grid overflow-hidden rounded-2xl bg-white shadow-sm lg:grid-cols-5">
    <div class="bg-gray-800 p-8 text-white lg:col-span-2 sm:p-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-blue-300">Hablemos</p>
      <h2 class="mb-4 text-3xl font-bold">Contact</h2>
      <p class="mb-10 leading-7 text-gray-300">¿Tienes una pregunta sobre la biblioteca o el proyecto? Puedes comunicarte por cualquiera de estos medios.</p>
      <address class="space-y-6 not-italic">
        <div class="flex items-start">
          <i class="fas fa-envelope mr-4 mt-1 text-blue-400"></i>
          <div><p class="font-semibold">Correo</p><a class="text-sm text-gray-300 hover:text-white" href="mailto:admin@example.com">admin@example.com</a></div>
        </div>
        <div class="flex items-start">
          <i class="fas fa-phone mr-4 mt-1 text-blue-400"></i>
          <div><p class="font-semibold">Teléfono</p><a class="text-sm text-gray-300 hover:text-white" href="tel:+573001234567">+57 300 123 4567</a></div>
        </div>
        <div class="flex items-start">
          <i class="fas fa-location-dot mr-4 mt-1 text-blue-400"></i>
          <div><p class="font-semibold">Ubicación</p><p class="text-sm text-gray-300">Medellin, Colombia</p></div>
        </div>
      </address>
    </div>

    <div class="p-8 lg:col-span-3 sm:p-10">
      <h3 class="mb-6 text-2xl font-bold">Envíanos un mensaje</h3>
      <form class="space-y-5" action="#" method="get">
        <div>
          <label class="mb-2 block text-sm font-semibold text-gray-700" for="name">Nombre</label>
          <input class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" id="name" name="name" type="text" placeholder="Tu nombre">
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-gray-700" for="email">Correo electrónico</label>
          <input class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" id="email" name="email" type="email" placeholder="nombre@ejemplo.com">
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-gray-700" for="message">Mensaje</label>
          <textarea class="min-h-32 w-full resize-y rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" id="message" name="message" placeholder="Escribe tu mensaje"></textarea>
        </div>
        <button class="rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition hover:bg-blue-700" type="button">
          <i class="fas fa-paper-plane mr-2"></i>Enviar mensaje
        </button>
      </form>
    </div>
  </div>
</section>
