{
  "name": "fullstack",
  "version": "1.0.0",
  "description": "Aplicaci\u00f3n MPA/SSR con Express, TypeScript, EJS y Tailwind CSS",
  "main": "dist/Index.js",
  "scripts": {
    "dev": "tsx watch src/Index.ts",
    "dev:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/public/css/style.css --watch",
    "build": "npm run build:css && tsc",
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/public/css/style.css --minify",
    "start": "node dist/Index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
